# ============================================================
# 项目配置（复制为 .env 后填写实际值）
# ============================================================

# Anthropic API Key（沿用现有工作流）
ANTHROPIC_API_KEY=

# ── Obsidian Vault ───────────────────────────────────────────
# Vault 根目录的绝对路径。
# 编排引擎通过此路径读写角色基因（00-系统/角色基因/）、
# 项目产出（10-项目/{project}/）等内容。
# Windows 示例：
#   VAULT_ROOT=D:\MarkDown\memory\adam
# macOS / Linux 示例：
#   VAULT_ROOT=/Users/you/Documents/Obsidian/adam
VAULT_ROOT=D:\MarkDown\memory\adam

# Obsidian Local REST API 插件配置（用于跨进程读取与搜索）
# 写操作建议直接使用文件系统，避免 REST API 的开销。
# Token 在 Obsidian 设置 → Local REST API 中生成。
OBSIDIAN_REST_API_URL=http://127.0.0.1:27123
OBSIDIAN_REST_API_TOKEN=

# ── 工作流（沿用现有）─────────────────────────────────────
# 执行的目标技能/角色（chief_architect / technical_lead / dev_backend / dev_frontend / product_manager）
TARGET_SKILL=chief_architect
# 任务描述
TASK=
# 单技能最大重试次数
MAX_ITER=3
# 子进程超时（秒）
SKILL_TIMEOUT=300
# 技能 blocked 时是否阻塞全局
SET_GLOBAL_BLOCK=false

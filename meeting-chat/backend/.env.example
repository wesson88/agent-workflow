# ============================================================
# 多Agent智能会议聊天系统 - 环境变量配置模板
#
# 使用方法：
#   复制此文件为 .env，然后填入真实的 API Key
#   cp .env.example .env
#
# ⚠️  .env 文件包含真实 Key，已加入 .gitignore，绝不提交到 git
# ✅  .env.example 是安全模板，可以提交到 git
# ============================================================

# ── DeepSeek（主持人 / 产品经理默认使用）─────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Claude 双轨配置（架构师 / 技术主管 / 后端 / 前端）─────────
# 优先级策略: auto=有API用API | cli=优先CLI | api=仅API
CLAUDE_PREFER=auto

# 轨道1：API Key（填写后自动启用）
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com/v1
CLAUDE_MODEL=claude-opus-4-5

# 轨道2：CLI（安装后自动启用，无需 API Key）
# 安装: npm install -g @anthropic-ai/claude-code
# 登录: claude login
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=claude-opus-4-5

# ── OpenAI Codex（测试工程师）────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CODEX_MODEL=codex-mini-latest

# ── Gemini（UX设计师，UI代码生成）────────────────────────────
# 申请地址: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-pro-preview-06-05

# ── skill.md 增强开关 ─────────────────────────────────────
SKILL_AUGMENT=false

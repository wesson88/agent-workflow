# ── 敏感配置（绝不提交）─────────────────────────────────────
.env
.env.local
.env.*.local
*.key
*.pem
*.p12

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# ── Node / 前端 ────────────────────────────────────────────
node_modules/

# ── 运行时日志 ────────────────────────────────────────────
logs/

# ── Claude 工作流运行时产物（仅排除运行时，保留框架本体）──
.claude/settings.local.json
.claude/audit.jsonl
.claude/status.json
.claude/instructions/
.claude/skills/**/__pycache__/
.claude/__pycache__/
.claude/engine/__pycache__/
.claude/docs/system_design.md
.claude/docs/api_spec.md
.claude/requirements/PRD.md

# Phase 2b 起：dev_backend / dev_frontend 写代码到仓根 src/ tests/，
# 这些是工作流的产出（每个项目一份），不应入引擎仓
/src/
/tests/

# ── 私密脑暴素材（不公开，模板和 README 保留）──
.claude/inputs/*.md
!.claude/inputs/*.example.md
!.claude/inputs/README.md

# ── 编辑器 ─────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── 系统文件 ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# Demo 项目跑出来的 pytest 全局 fixture（conftest.py 必须在仓根才生效）
/conftest.py
